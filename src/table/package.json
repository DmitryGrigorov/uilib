{
  "name": "@dmitrygrigorov/table",
  "sideEffects": [
    "*.css"
  ],
  "version": "1.8.1",
  "author": "Dmitry Grigorov",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "directories": {
    "lib": "lib"
  },
  "main": "umd/index.js",
  "module": "esm/index.js",
  "types": "types/index.d.ts",
  "keywords": [
    "react",
    "react-component",
    "design system",
    "grid",
    "data",
    "table"
  ],
  "scripts": {
    "tsc": "npm run eslint && tsc -p tsconfig.json && tsc --outDir ../../publish-table/umd --module commonjs --resolveJsonModule false && tsc --outDir ../../publish-table/types --emitDeclarationOnly true --declaration true --allowJs false --isolatedModules true",
    "check-types": "tsc --noEmit",
    "eslint": "eslint --ext .js,.jsx,.ts,.tsx",
    "postversion": "cp -r ./package.json ../src/table/"
  },
  "dependencies": {
    "date-fns": "4.4.0",
    "react-transition-group": "4.4.5"
  },
  "peerDependencies": {
    "@dmitrygrigorov/icons": ">=1.0.0",
    "@dmitrygrigorov/components": ">=1.0.0",
    "polished": "^4.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tslib": "^2.3.1",
    "styled-components": "^6.0.0"
  },
  "description": "Custom virtualized table engine with nested rows and column context menus",
  "repository": {
    "type": "git",
    "url": "https://github.com/DmitryGrigorov/uilib.git"
  },
  "resolutions": {
    "styled-components": "^6"
  }
}
