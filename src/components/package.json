{
  "name": "@dmitrygrigorov/components",
  "sideEffects": [
    "*.css"
  ],
  "version": "1.25.0",
  "author": "Dmitry Grigorov",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "directories": {
    "lib": "lib"
  },
  "main": "umd/index.js",
  "module": "esm/index.js",
  "types": "types/index.d.ts",
  "keywords": [
    "react",
    "react-component",
    "design system"
  ],
  "scripts": {
    "tsc": "npm run eslint && tsc -p tsconfig.json && tsc --outDir ../../publish-components/umd --module commonjs --resolveJsonModule false && tsc --outDir ../../publish-components/types --emitDeclarationOnly true --declaration true --allowJs false --isolatedModules true",
    "check-types": "tsc --noEmit",
    "eslint": "eslint --ext .js,.jsx,.ts,.tsx",
    "postversion": "cp -r ./package.json ../src/components/"
  },
  "dependencies": {
    "async-validator": "^4.2.5",
    "date-fns": "4.4.0",
    "react-imask": "7.6.1",
    "react-number-format": "5.4.5",
    "react-select": "5.10.2",
    "react-transition-group": "4.4.5",
    "text-mask-addons": "^3.8.0"
  },
  "devDependencies": {
    "style-loader": "4.0.0",
    "style-resources-loader": "1.5.0",
    "prettier": "3.9.6"
  },
  "peerDependencies": {
    "@dmitrygrigorov/icons": ">=1.0.0",
    "polished": "^4.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tslib": "^2.3.1",
    "styled-components": "^6.0.0"
  },
  "description": "React UI components with an orange design-token theme and Motion-based animations",
  "repository": {
    "type": "git",
    "url": "https://github.com/DmitryGrigorov/uilib.git"
  },
  "resolutions": {
    "styled-components": "^6"
  }
}
