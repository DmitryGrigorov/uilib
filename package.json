{
  "name": "uilib",
  "version": "0.0.1-0",
  "description": "React UI component library with an orange design-token theme, Motion-based animations, a custom virtualized table engine, and 1200+ generated icons",
  "author": "Dmitry Grigorov",
  "license": "ISC",
  "private": false,
  "scripts": {
    "start": "storybook dev -p 6006",
    "build": "storybook build -o storybook-static/storybook",
    "prettier:base": "prettier --config ./prettier.config.js",
    "prettier:check": "npm run prettier:base -- --list-different \"./src/**/*.{d.ts,ts,tsx}\"",
    "prettier:write": "npm run prettier:base -- --write \"./src/**/*.{d.ts,ts,tsx}\"",
    "eslint": "eslint --cache --ext .js,.jsx,.ts,.tsx src",
    "eslint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx src",
    "lint:types": "tsc",
    "lint:css": "stylelint \"./src/**/styles.ts\"",
    "lint": "npm run eslint && npm run prettier:check && npm run lint:css",
    "tsc:components": "cd ./src/components && npm run tsc",
    "tsc:table": "cd ./src/table && npm run tsc",
    "tsc:check": "cd ./src/components && npm run check-types",
    "tsc:icons": "cd ./src/icons && npm run tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:clear": "jest --clearCache",
    "prepatch": "cd ./src/components && npm version prepatch",
    "prerelease": "cd ./src/components && npm version prerelease",
    "patch": "cd ./src/components && npm version patch",
    "major": "cd ./src/components && npm version major",
    "minor": "cd ./src/components && npm version minor",
    "publish": "cd ./publish-components && npm publish",
    "pre-commit": "lint-staged --max-arg-length=4000",
    "pre-push": "npm run tsc:check && npm run lint:css",
    "build-icons": "node scripts/build-icons.js",
    "build-icons-vue": "node scripts/build-icons-vue.js",
    "patch:icons": "cd ./src/icons && npm version patch",
    "minor:icons": "cd ./src/icons && npm version minor",
    "major:icons": "cd ./src/icons && npm version major",
    "prerelease:icons": "cd ./src/icons && npm version prerelease --preid=next",
    "publishIcons": "cd ./publish-icons && npm publish",
    "patch:dotfiles": "cd ./packages/dotfiles && npm version patch",
    "publish-dotfiles": "cd ./publish-dotfiles && npm publish",
    "prepare": "husky",
    "semantic-release": "multi-semantic-release",
    "site:start": "node src/site/build/script.js && cross-env NODE_ENV=development vite serve ./src/site --open --mode development --config ./src/site/vite.config.mjs",
    "site:build": "node src/site/build/script.js && cross-env NODE_ENV=production vite build ./src/site --mode production --config ./src/site/vite.config.mjs"
  },
  "dependencies": {
    "@dmitrygrigorov/dotfiles": ">=1.0.0",
    "@emotion/is-prop-valid": "^1.4.0",
    "async-validator": "^4.2.5",
    "highlight.js": "^11.11.1",
    "mobx": "^7.0.0",
    "mobx-react-lite": "^5.0.0",
    "motion": "^13.0.0",
    "polished": "4.3.1",
    "react-imask": "7.6.1",
    "react-live": "^4.1.8",
    "react-number-format": "5.4.5",
    "react-router-dom": "^7.18.2",
    "react-select": "5.10.2",
    "react-syntax-highlighter": "^16.1.1",
    "react-transition-group": "^4.4.5",
    "storybook": "^10.5.7",
    "text-mask-addons": "^3.8.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@babel/types": "7.29.8",
    "@dmitrygrigorov/components": ">=1.0.0",
    "@dmitrygrigorov/icons": ">=1.0.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@qiwi/multi-semantic-release": "^7.1.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/gitlab": "^13.3.3",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-links": "^10.5.7",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/builder-vite": "^10.5.7",
    "@storybook/cli": "^10.5.7",
    "@storybook/react": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@svgr/plugin-prettier": "8.1.0",
    "@swc/core": "^1.15.47",
    "@swc/plugin-styled-components": "^12.15.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest-image-snapshot": "^6.4.1",
    "@types/jsdom-screenshot": "^4.0.0",
    "@types/mdx-js__react": "^2.0.0",
    "@types/node": "^26.2.0",
    "@types/puppeteer": "^7.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/react-transition-group": "^4.4.12",
    "@types/styled-components": "5.1.36",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "assert": "^2.1.0",
    "babel-jest": "^30.4.1",
    "babel-plugin-styled-components": "2.3.0",
    "camelcase": "9.0.0",
    "cross-env": "^10.1.0",
    "date-fns": "4.4.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-standard": "17.1.0",
    "eslint-import-resolver-node": "0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.16.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-optimize-regex": "1.2.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "^10.5.7",
    "fs": "0.0.1-security",
    "fs-extra": "11.4.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^30.4.1",
    "jest-image-snapshot": "^6.5.2",
    "jest-styled-components": "^7.4.0",
    "jest-transform-stub": "^2.0.0",
    "lint-staged": "17.3.0",
    "postcss-scss": "^4.0.9",
    "postcss-styled-syntax": "^0.7.2",
    "prettier": "3.9.6",
    "puppeteer": "25.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "semantic-release": "^25.0.9",
    "semantic-release-npm-deprecate": "^1.0.34",
    "semantic-release-telegram-bot": "^2.0.1",
    "storybook-dark-mode": "^5.0.0",
    "styled-components": "6.5.1",
    "stylelint": "17.14.1",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-styled-components": "0.1.1",
    "ts-jest": "^29.4.12",
    "typescript": "6.0.3",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.2.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vue": "^3.5.41"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "styled-components": "6.5.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DmitryGrigorov/uilib.git"
  },
  "resolutions": {
    "styled-components": "^6"
  },
  "keywords": [
    "design",
    "system",
    "uilib"
  ],
  "workspaces": [
    "./src/components",
    "./src/icons",
    "./packages/dotfiles",
    "./src/table"
  ]
}
