{
  "extends": "./tsextend.json",
  "compilerOptions": {
    "outDir": "build",
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "moduleResolution": "bundler",
    "noUncheckedSideEffectImports": false,
    "target": "ES6",
    "lib": ["ES2022", "dom"],
    "paths": {
      "src": ["./src"],
      "src/*": ["./src/*"],
      "packages/*": ["./packages/*"],
      "react-select/dist/declarations/src/Select": [
        "./node_modules/react-select/dist/declarations/src/Select.d.ts"
      ]
    },
  },
  "exclude": [
    "node_modules",
    ".npm",
    "build",
    "nginx",
    "public",
    "scripts",
    "jest",
    "inject-components-test",
    "**/svgToTsx.js",
    "**/template*.js",
    "**/*.doc.mdx",
    "src/table/shims-jsx.d.ts",
    "src/icons/shims-jsx.d.ts"
  ],
  "include": [
    "src",
    "./src/**/*",
    "docs",
    "./docs/**/*",
    "types",
    "./vite.config.ts",
    ".storybook",
    "./.storybook/**/*",
    "./jest.setup.ts"
  ]
}
